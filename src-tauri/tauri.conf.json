{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "MikosChat",
    "version":  "0.1.1",
    "identifier":  "pl.mikrusmusic.mikoschat.desktop",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "MikosChat",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  800,
                                    "minHeight":  600,
                                    "center":  true,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: https://api.chat.mikrusmusic.pl https://chat.mikrusmusic.pl; media-src \u0027self\u0027 blob: https://api.chat.mikrusmusic.pl; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ipc: http://ipc.localhost https://api.chat.mikrusmusic.pl wss://api.chat.mikrusmusic.pl; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027none\u0027; frame-src \u0027none\u0027",
                                 "devCsp":  "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: https://api.chat.mikrusmusic.pl https://chat.mikrusmusic.pl; media-src \u0027self\u0027 blob: https://api.chat.mikrusmusic.pl; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 ws://127.0.0.1:1420 ipc: http://ipc.localhost https://api.chat.mikrusmusic.pl wss://api.chat.mikrusmusic.pl; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027none\u0027; frame-src \u0027none\u0027"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis",
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "publisher":  "MikrusMusic",
                   "copyright":  "Copyright (c) 2026 Mateusz Obirek",
                   "category":  "SocialNetworking",
                   "shortDescription":  "MikosChat desktop client",
                   "longDescription":  "Open-source messaging client with real-time communication and native Windows integration.",
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper",
                                                              "silent":  true
                                                          },
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "installerIcon":  "icons/icon.ico",
                                                "languages":  [
                                                                  "English",
                                                                  "Polish"
                                                              ],
                                                "displayLanguageSelector":  true
                                            },
                                   "wix":  {
                                               "language":  "en-US"
                                           }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "requireSignedVersion":  true,
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4OEY5QzE5Qjg5NDAyMzcKUldRM0FwUzRHWnlQQ0JZelJOVXBpQnQ0MjVjWXhtTzJJaW5UYmFSTTY1djdGSGNtL1hNZitQKysK",
                                    "endpoints":  [
                                                      "https://github.com/Matisiowy/MikosChat-Desktop/releases/download/alpha-updates/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}